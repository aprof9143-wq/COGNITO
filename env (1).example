# ============================================================
# NeuroSymbolic Verifier — Environment Variables
# ============================================================
# Rename this file to .env and fill in your values.
# NEVER commit the real .env to version control.
#
# On Streamlit Cloud, set secrets via:
#   Manage app → Secrets
# and add:  ANTHROPIC_API_KEY = "sk-ant-..."
# ============================================================

# ── Anthropic API Key ────────────────────────────────────────
# Required for all LLM calls (M2, M4, draft generation).
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=


# ── ChromaDB Storage Path (M3) ───────────────────────────────
CHROMA_STORAGE_PATH=./chroma_storage


# ── Streamlit Server (optional, for self-hosting) ────────────
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
# STREAMLIT_SERVER_HEADLESS=true
