# ============================================================
# NeuroSymbolic Verifier — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.
#
# Load in Python with:
#   from dotenv import load_dotenv; load_dotenv()
#   import os; api_key = os.getenv("GEMINI_API_KEY")
# ============================================================


# ── Google Gemini API Key ────────────────────────────────────
# Required for M2 (LLM Parser + Auditor) and M4 (Agentic Router)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyDukdYSxADiVSvQa83Oem7IHzNw6orKeEc


# ── ChromaDB Storage Path (M3 Semantic Memory) ───────────────
# Absolute or relative path where ChromaDB persists its data.
# Default used in m3_vector_db.py is ./chroma_storage
CHROMA_STORAGE_PATH=./chroma_storage


# ── Streamlit Server Settings (optional) ────────────────────
# Uncomment to override Streamlit defaults when self-hosting.
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
# STREAMLIT_SERVER_HEADLESS=true


# ── Pipeline Defaults (optional) ────────────────────────────
# Override default behaviour without touching source code.
# LTN_PASS_THRESHOLD=0.8       # Score >= this = PASS
# MAX_MEMORY_RESULTS=4         # ChromaDB top-k retrieval
# GEMINI_GENERATION_MODEL=gemini-2.5-flash
# GEMINI_PARSE_MODEL=gemini-2.5-flash
